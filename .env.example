# ── SRS Server Environment Variables ─────────────────────────────────────────
# Copy to .env and fill in values before running docker compose up.

# ── Ports ─────────────────────────────────────────────────────────────────────
RTMP_PORT=1935
HTTP_PORT=8080
API_PORT=1985
WEBRTC_PORT=8000
HOOK_PORT=5000

# ── WebRTC ────────────────────────────────────────────────────────────────────
# Public IP or hostname that WebRTC clients will connect to.
# Use your server's public IP for production.
CANDIDATE=127.0.0.1

# ── Stream auth ───────────────────────────────────────────────────────────────
# If set, publishers must include ?token=<value> in their RTMP URL.
# Leave blank to disable token auth.
STREAM_SECRET=

# ── Hook server ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── DVR / S3 (optional) ───────────────────────────────────────────────────────
# Leave S3_BUCKET blank to skip S3 upload.
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
